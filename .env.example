# Gemini extracts the catalogue from speech and turns voice edits into patches.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.5-flash-lite)
GEMINI_MODEL=

# Optional: store catalogues as JSON commits in a GitHub repo (history = undo).
# Without these, catalogues are saved to ./data/catalogues on the local disk.
GITHUB_TOKEN=
GITHUB_REPO=yaswanth528/claude-genie
GITHUB_BRANCH=main

# Free stock photos when the owner adds none (and Gemini can't generate images)
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Separate customer websites on Cloudflare Pages
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Admin panel at /admin (8+ characters)
ADMIN_PASSWORD=

# Owner login by WhatsApp code (Meta WhatsApp Cloud API, AUTHENTICATION template with copy-code button)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=verification_code
WHATSAPP_TEMPLATE_LANG=en_US
# Signs login sessions (any long random string)
AUTH_SECRET=

# Daily job (Vercel Cron) and emails
CRON_SECRET=
BREVO_API_KEY=
ALERT_FROM_EMAIL=
SUPPORT_EMAIL=
